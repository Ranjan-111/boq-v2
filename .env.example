# ---- boq-v2 environment (dev defaults) ----
# Copy to .env and adjust. NEVER commit .env.

# App
APP_NAME=boq-v2
ENV=dev
LOG_LEVEL=INFO

# Database (Postgres 16)
DATABASE_URL=postgresql+asyncpg://boq:boq@localhost:5432/boq

# JWT auth
JWT_SECRET=CHANGE-ME-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
# S3 mode:
# STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=boq-v2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Uploads
MAX_UPLOAD_MB=200
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,image/webp,application/dxf

# Jobs
JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3

# Production deploy (docker-compose.prod.yml) — see docs/deploy.md.
# Required by prod compose (never defaults for secrets); NOT needed for dev.
# JWT_SECRET=            # openssl rand -hex 32
# POSTGRES_PASSWORD=     # alphanumeric only
# MINIO_ROOT_PASSWORD=  # alphanumeric only; used only by minio-init
# MINIO_APP_PASSWORD=    # the least-privilege boq-app user the app uses
# Caddy TLS profile (real deployments):
# CADDY_CONFIG=tls
# PUBLIC_DOMAIN=boq.example.com
# ACME_EMAIL=ops@example.com

# AI (Round 4+)
# AI_PROVIDER=anthropic
# AI_API_KEY=
AI_COST_CAP_PER_CALL_USD=0.50
